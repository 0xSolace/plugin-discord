# Discord Activity Configuration
# =============================
# The Discord Activity can use the same application as your bot,
# or a separate application if you prefer.
#
# Required environment variables:
# - DISCORD_CLIENT_ID: Your Discord Application ID (Client ID)
# - DISCORD_CLIENT_SECRET: Your Discord Client Secret from OAuth2 settings

DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# Server Configuration
PORT=3001

# ElizaOS Integration
ELIZAOS_API_URL=http://localhost:3000  # Points to main ElizaOS API server 